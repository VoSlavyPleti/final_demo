# Paths from the project root, or absolute paths. CLI flags override them.
AGENT_CONTRACT_PATH=inputs/contract.txt
AGENT_MATRIX_PATH=inputs/matrix.json
AGENT_OUTPUT_PATH=outputs/result.json
# full prints model messages and tool inputs/results; compact prints metadata only.
# Full console logs contain confidential document content.
AGENT_CONSOLE_LOG=full

# Corporate model gateway; no real addresses, keys or certificates in this file.
# LOCAL=true: HTTPS with mTLS. LOCAL=false: internal HTTP gateway (example semantics).
LOCAL=true
GIGACHAT_HOST=gateway.company.invalid
GIGACHAT_PORT=443
GIGACHAT_ENDPOINT=/v1
GIGACHAT_TLS_CERT_FILEPATH=C:/certs/client.pem
GIGACHAT_KEY_FILEPATH=C:/certs/client.key
# Optional when the issuer is already trusted by the runtime.
GIGACHAT_CA_BUNDLE_FILEPATH=C:/certs/corporate-ca.pem
GIGACHAT_VERIFY_SSL_CERTS=true

# WorkStation is configured separately from the model gateway.
AGENT_BACKEND=aef
AEF_WORKSTATION_ENV=test
AEF_WORKSTATION_BASE_URL=https://workstation.dev0.apps.azwx5oj1.k8s.delta.sbrf.ru
# Optional WorkStation CA/create secret; independent of GigaChat certificates.
# AEF_CA_BUNDLE=C:/certs/workstation-ca.pem
# AEF_SESSION_CREATE_SECRET=<from secret store>
AEF_IDLE_TIMEOUT_SEC=900
AEF_ABSOLUTE_TTL_SEC=3600
AEF_HEARTBEAT_SEC=60
